# Better-PaaS frontend configuration (all optional)

# Backend API base URL. Required when the dashboard and API are on different hosts
# (e.g. dashboard at https://paas.better-paas.com, API at http://your-vps:8080).
# The paas CLI reads /.well-known/better-paas.json from the dashboard to discover this.
# NEXT_PUBLIC_API_URL=http://92.113.150.63:8080

# Public dashboard URL (optional). Defaults to the URL you open in the browser.
# NEXT_PUBLIC_PAAS_UI_URL=https://paas.better-paas.com
